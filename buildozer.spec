[app]

# Titolo dell'applicazione
title = HelloKivy

# Nome del pacchetto (senza spazi o caratteri speciali)
package.name = hellokivy

# Dominio del pacchetto
package.domain = org.example

# Cartella di origine del codice sorgente
source.dir = .

# Estensioni dei file da includere nel pacchetto
source.include_exts = py,png,jpg,kv,atlas

# Versione dell'applicazione
version = 0.1

# Requisiti necessari per l'app Python/Kivy
requirements = python3,kivy

# Orientamento dello schermo (portrait o landscape)
orientation = portrait

# Modalità schermo intero (0 = disattivato, 1 = attivato)
fullscreen = 0

# Configurazione specifica per Android
android.api = 33
android.minapi = 21

# Versione NDK stabile e compatibile con python-for-android
android.ndk = 25b

# Accettazione automatica delle licenze SDK di Google
android.accept_sdk_license = True
